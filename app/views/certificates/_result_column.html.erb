<%= tag.aside id: "search_result", class: [ "result-column", ("has-result" if outcome.in?(%i[found not_found unavailable too_many_requests type_not_verifiable issued_before_limit])) ],
              aria: { live: "polite", label: t("certificates.new.result_label") } do %>
  <%= render "certificates/result", outcome:, certificate:, search:, category:, verifiable_from: local_assigns[:verifiable_from] %>
<% end %>
