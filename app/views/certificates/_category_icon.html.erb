<%# Ikona kategorii (zakładki, stopka). Opcjonalnie: size (domyślnie 24), css_class. %>
<% size = local_assigns.fetch(:size, 24) %>
<% case category.code %>
<% when "M" %>
  <svg aria-hidden="true" class="<%= local_assigns[:css_class] %>" width="<%= size %>" height="<%= size %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><path d="M12 7v14M5 12H3a9 9 0 0 0 18 0h-2M8 10h8"/></svg>
<% when "L" %>
  <svg aria-hidden="true" class="<%= local_assigns[:css_class] %>" width="<%= size %>" height="<%= size %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
<% when "R" %>
  <svg aria-hidden="true" class="<%= local_assigns[:css_class] %>" width="<%= size %>" height="<%= size %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12v9M9 21h6M8.5 8.5a5 5 0 0 1 7 0M6 6a8.5 8.5 0 0 1 12 0"/><circle cx="12" cy="11" r="1.5"/></svg>
<% end %>
