<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <%# Tryb jasny/ciemny ustawiany przed narysowaniem strony (bez mignięcia): wybór z przełącznika, a bez niego – ustawienie systemu. %>
    <script>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "dark" && theme !== "light") {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-bs-theme", theme);
      })();
    </script>
    <title><%= content_for(:title) || t("layouts.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t("layouts.description") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag "favicon.ico" %>
    <%= stylesheet_link_tag "bootstrap.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "layouts/matomo" if Rails.configuration.x.confirmation.dig(:matomo, :enabled) %>
  </head>

  <body>
    <a class="skip-link" href="#content"><%= t("layouts.skip_to_content") %></a>

    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: "site-header__logo" do %>
          <%= image_tag t("layouts.header.logo_file"), alt: t("layouts.header.logo_alt"), width: 440, height: 41 %>
        <% end %>
        <nav class="site-header__nav" aria-label="<%= t("layouts.header.menu") %>">
          <button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle"
                  aria-pressed="false" title="<%= t("layouts.header.theme.dark") %>">
            <svg class="theme-toggle__icon--moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme-toggle__icon--sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <span class="visually-hidden"><%= t("layouts.header.theme.dark") %></span>
          </button>
          <div class="lang-switch" role="group" aria-label="<%= t("layouts.header.language.label") %>">
            <%= other_locale_links %>
          </div>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <% if flash[:alert] %>
        <div class="container-narrow"><div class="flash flash--alert" role="alert"><%= flash[:alert] %></div></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <p class="site-footer__brand"><%= t("layouts.footer.brand") %></p>
          <p><%= t("layouts.footer.brand_note") %></p>
        </div>
        <div>
          <p class="site-footer__heading"><%= t("layouts.footer.contact") %></p>
          <p><%= mail_to t("layouts.footer.contact_mail") %></p>
        </div>
        <div>
          <p class="site-footer__heading"><%= t("layouts.footer.links") %></p>
          <ul>
            <li><%= link_to t("pages.declaration.title"), declaration_path %></li>
            <li><%= link_to "UKE", t("layouts.footer.uke_url") %></li>
            <li><%= link_to "Facebook", "https://web.facebook.com/UrzadKomunikacjiElektronicznej" %></li>
            <li><%= link_to "Twitter", "https://twitter.com/uke2uke" %></li>
          </ul>
          <p class="site-footer__copy">&copy; 2018 UKE</p>
        </div>
      </div>
    </footer>
  </body>
</html>
